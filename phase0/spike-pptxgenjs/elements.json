 "2": [
  {
   "t": "text",
   "x": 0.7357,
   "y": 2.251,
   "w": 6.7482,
   "h": 1.0834,
   "lines": [
    {
     "txt": "DEINE CATERING- &",
     "size": 36.0,
     "color": "FFFFFF",
     "weight": "ExtraBold",
     "italic": false
    },
    {
     "txt": "EVENT-CREW IM NORDEN",
     "size": 36.02,
     "color": "FFFFFF",
     "weight": "ExtraBold",
     "italic": false
    }
   ]
  },
  {
   "t": "text",
   "x": 0.7357,
   "y": 3.8451,
   "w": 6.709,
   "h": 1.1286,
   "lines": [
    {
     "txt": "Seit 15 Jahren rockt unser TEAM KOCHfabrik die Event-Catering-Szene",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    },
    {
     "txt": "mit Liebe, Respekt und einem untr\u00fcglichen Sinn f\u00fcr Stil und",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Bold",
     "italic": false
    },
    {
     "txt": "Geschmack. Der enge und pers\u00f6nliche Kontakt zu unseren Kunden",
     "size": 14.06,
     "color": "FFFFFF",
     "weight": "Bold",
     "italic": false
    },
    {
     "txt": "und ma\u00dfgeschneiderte Genuss-Erlebnisse stehen im Mittelpunkt",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    },
    {
     "txt": "unseres Schaffens.",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    }
   ]
  },
  {
   "t": "text",
   "x": 0.7357,
   "y": 5.1787,
   "w": 6.8184,
   "h": 1.3621,
   "lines": [
    {
     "txt": "Vergesst 'Standard' \u2013 wir denken mit euch um Ecken und kreieren",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Bold",
     "italic": false
    },
    {
     "txt": "Erlebnisse, die den Puls eurer G\u00e4ste beschleunigen. Mit uns als Partner",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Bold",
     "italic": false
    },
    {
     "txt": "wird jedes Detail eurer Veranstaltung zum Statement. Wir sind mehr als",
     "size": 14.06,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    },
    {
     "txt": "nur euer Caterer \u2013 wir sind eure Verb\u00fcndeten auf dem Weg zu einem",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    },
    {
     "txt": "unvergesslichen Event. Eure Vision, unser gemeinsamer Nervenkitzel \u2013",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Bold",
     "italic": false
    },
    {
     "txt": "f\u00fcr kulinarische Momente, die mehr als Geschmack hinterlassen.",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    }
   ]
  },

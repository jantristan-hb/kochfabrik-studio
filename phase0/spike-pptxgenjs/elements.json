 "7": [
  {
   "t": "text",
   "x": 5.6593,
   "y": 2.275,
   "w": 5.135,
   "h": 1.0836,
   "lines": [
    {
     "txt": "WERTSCH\u00c4TZUNG",
     "size": 36.0,
     "color": "FFFFFF",
     "weight": "ExtraBold",
     "italic": false
    },
    {
     "txt": "IST DER SCHL\u00dcSSEL",
     "size": 36.0,
     "color": "AA8339",
     "weight": "ExtraBold",
     "italic": false
    }
   ]
  },
  {
   "t": "text",
   "x": 5.6986,
   "y": 3.8571,
   "w": 7.0587,
   "h": 0.7084,
   "lines": [
    {
     "txt": "Unser Ziel? Euch mitten ins Herz zu treffen. Mit multiplen kulinarischen",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Bold",
     "italic": false
    },
    {
     "txt": "H\u00f6hepunkten, einer professionellen Service-Crew und einer perfekten",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Bold",
     "italic": false
    },
    {
     "txt": "Planung. Das ist unsere Art, euch zu sagen: \u201eWir sch\u00e4tzen euch.\u201c",
     "size": 14.06,
     "color": "FFFFFF",
     "weight": "Bold",
     "italic": false
    }
   ]
  },
  {
   "t": "text",
   "x": 5.6986,
   "y": 4.7942,
   "w": 7.1206,
   "h": 1.992,
   "lines": [
    {
     "txt": "Wir sind die Crew, die keinen Unterschied zwischen Tellerw\u00e4scher und Big",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    },
    {
     "txt": "Boss macht. Bei uns z\u00e4hlt jeder, Punkt. Und weil wir wollen, dass unsere",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    },
    {
     "txt": "n\u00e4chsten Generationen noch was vom Morgen haben, pflanzen wir heute",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    },
    {
     "txt": "die Samen f\u00fcr morgen \u2013 nachhaltig und mit Wow-Effekt. In unserer",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Bold",
     "italic": false
    },
    {
     "txt": "K\u00fcche spielen wir mit regionalen und saisonalen Zutaten. Fleisch, Fisch",
     "size": 14.06,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    },
    {
     "txt": "und Federvieh kommen bei uns ausschlie\u00dflich von Lieferanten unseres",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    },
    {
     "txt": "Vertrauens. Das ist unser Engagement f\u00fcr euch und f\u00fcr unseren Planeten",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Bold",
     "italic": false
    },
    {
     "txt": "\u2013 voller Geschmack und mit jeder Menge Liebe.",
     "size": 14.04,
     "color": "FFFFFF",
     "weight": "Regular",
     "italic": false
    }
   ]
  },
